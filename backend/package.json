{
  "name": "orcamentos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de orçamentos e cobranças para prestadores de serviço autônomos",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "prisma migrate deploy && node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "db:seed": "node prisma/seed.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "start:prod": "prisma migrate deploy && node src/server.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "baileys": "7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  }
}
