# Supabase -> Project Settings -> Database -> Connection string
# Pooler (transaction mode) para a aplicação
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta para migrations
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

PORT=3333
# Origens do frontend separadas por vírgula (ex: http://localhost:5173)
CORS_ORIGIN=*

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# Job diário de vencimentos
CRON_ENABLED=true
CRON_SCHEDULE="0 8 * * *"
CRON_TIMEZONE=America/Sao_Paulo

# Canal de notificação: console (simulação). Passo 4 adiciona whatsapp.
NOTIFIER=console
ALERT_MAX_ATTEMPTS=3
