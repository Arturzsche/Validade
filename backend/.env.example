# Supabase -> Project Settings -> Database -> Connection string
# Pooler (transaction mode) para a aplicação
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta para migrations
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

PORT=3333
# Origens do frontend separadas por vírgula (ex: http://localhost:5173)
CORS_ORIGIN=*

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# Job diário de vencimentos
CRON_ENABLED=true
CRON_SCHEDULE="0 8 * * *"
CRON_TIMEZONE=America/Sao_Paulo

# Canal de notificação: console (simulação) | whatsapp (Baileys: QR no terminal)
NOTIFIER=console
ALERT_MAX_ATTEMPTS=3

# WhatsApp (NOTIFIER=whatsapp)
# Pasta da sessão: em Railway/Render monte um volume persistente aqui, senão o QR é pedido a cada deploy
WHATSAPP_AUTH_DIR=.wa-session
# Intervalo mínimo entre mensagens (anti-bloqueio)
WHATSAPP_SEND_INTERVAL_MS=3000
# E-mails (separados por vírgula) que podem ver o QR e reconectar pelo painel
WHATSAPP_ADMIN_EMAILS=
# Endereço do frontend: vira o link "abrir o painel" no relatório diário (opcional)
PUBLIC_APP_URL=
# Log interno do Baileys (é bem verboso em info/debug)
WHATSAPP_LOG_LEVEL=warn
