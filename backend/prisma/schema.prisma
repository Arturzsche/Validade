// =============================================================================
// Orçamentos e Cobranças para prestadores de serviço autônomos
// (eletricistas, encanadores, marceneiros, técnicos de manutenção)
// PostgreSQL (Neon) + Prisma ORM
//
// Multi-tenant simples: cada prestador (User) só enxerga os próprios clientes;
// orçamentos e itens chegam até ele pelo cliente.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon: conexão com pooler (-pooler no host)
  directUrl = env("DIRECT_URL")   // Neon: conexão direta, usada pelas migrations
}

enum QuoteStatus {
  PENDING  // Pendente: enviado, aguardando resposta do cliente
  APPROVED // Aprovado
  REJECTED // Rejeitado
}

// -----------------------------------------------------------------------------
// Prestador (conta de acesso)
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String? // WhatsApp do prestador (E.164)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clients Client[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// Clientes
// -----------------------------------------------------------------------------

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  phone     String? // WhatsApp do cliente (E.164) — destino do orçamento
  address   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotes Quote[]

  @@index([userId, name])
  @@map("clients")
}

// -----------------------------------------------------------------------------
// Orçamentos
// -----------------------------------------------------------------------------

model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  clientId    String      @map("client_id") @db.Uuid
  status      QuoteStatus @default(PENDING)
  totalAmount Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2) // soma dos itens (calculada no servidor)
  expiresAt   DateTime?   @map("expires_at") @db.Date // validade da proposta
  respondedAt DateTime?   @map("responded_at") @db.Timestamptz(3) // quando foi aprovado/rejeitado
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  // Restrict: excluir um cliente com orçamentos não apaga o histórico financeiro
  client Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items  QuoteItem[]

  @@index([clientId])
  @@index([status, respondedAt])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2) // aceita fração (ex: 2,5 m de fio)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  position    Int     @default(0) // ordem do item no orçamento (e no PDF)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
  @@map("quote_items")
}
